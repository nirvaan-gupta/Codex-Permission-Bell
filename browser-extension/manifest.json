{
  "manifest_version": 3,
  "name": "Permission Bell — AI Approval Alerts",
  "version": "1.0.0",
  "description": "Alerts the local Permission Bell Mac app when an AI approval is waiting in a background tab.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:18473/*", "https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Permission Bell"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"], "js": ["detection.js", "content.js"], "run_at": "document_idle"}]
}
